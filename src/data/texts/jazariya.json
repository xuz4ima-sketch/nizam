{"id":"jazariya","title":"المقدمة الجزرية","author":"ابن الجزري","category":"tajwid","kind":"poem","vocalized":false,"source":{"name":"ويكي مصدر (Wikisource)","page":"الجزرية","revid":498822,"url":"https://ar.wikisource.org/w/index.php?oldid=498822","license":"CC BY-SA 4.0"},"sections":[{"title":"المقدمة","items":[{"t":"b","s":"يقول راجي عفو رب سامع","a":"محمد بن الجزري الشافعي"},{"t":"b","s":"الحمد لله وصلى الله","a":"على نبيه ومصطفاه"},{"t":"b","s":"محمد وآله وصحبه","a":"ومقرئ القرآن مع محبه"},{"t":"b","s":"وبعد إن هذه مقدمه","a":"فيما على قارئه أن يعلمه"},{"t":"b","s":"إذ واجب عليهم محتم","a":"قبل الشروع أولا أن يعلموا"},{"t":"b","s":"مخارج الحروف والصفات","a":"ليلفظوا بأفصح اللغات"},{"t":"b","s":"محرري التجويد والمواقف","a":"وما الذي رسم في المصاحف"},{"t":"b","s":"من كل مقطوع وموصول بها","a":"وتاء أنثى لم تكن تكتب بها"}]},{"title":"باب مخارج الحروف","items":[{"t":"b","s":"مخارج الحروف سبعة عشر","a":"على الذي يختاره من اختبر"},{"t":"b","s":"فألف الجوف وأختاها وهي","a":"حروف مد للهواء تنتهي"},{"t":"b","s":"ثم لأقصى الحلق همز هاء","a":"ثم لوسطه فعين حاء"},{"t":"b","s":"أدناه غين خاؤها والقاف","a":"أقصى اللسان فوق ثم الكاف"},{"t":"b","s":"أسفل والوسط فجيم الشين يا","a":"والضاد من حافته إذ وليا"},{"t":"b","s":"لاضراس من أيسر أو يمناها","a":"واللام أدناها لمنتهاها"},{"t":"b","s":"والنون من طرفه تحت اجعلوا","a":"والرا يدانيه لظهر أدخل"},{"t":"b","s":"والطاء والدال وتا منه ومن","a":"عليا الثنايا والصفير مستكن"},{"t":"b","s":"من طرفيهما ومن بطن الشفة","a":"فالفا مع اطراف الثنايا المشرفة"},{"t":"b","s":"للشفتين الواو باء ميم","a":"وغنة مخرجها الخيشوم"}]},{"title":"صفات الحروف","items":[{"t":"b","s":"صفاتها جهر ورخو مستفل","a":"منفتح مصمتة والضد قل"},{"t":"b","s":"مهموسها فحثه شخص سكت","a":"شديدها لفظ أجد قط بكت"},{"t":"b","s":"وبين رخو والشديد لن عمر","a":"وسبع علو خص ضغط قظ حصر"},{"t":"b","s":"وصاد ضاد طاء ظاء مطبقة","a":"وفر من لب الحروف المذلقة"},{"t":"b","s":"صفيرها صاد وزاي سين","a":"قلقلة قطب جد واللين"},{"t":"b","s":"واو وياء سكنا وانفتحا","a":"قبلهما والانحراف صححا"},{"t":"b","s":"في اللام والرا وبتكرير جعل","a":"وللتفشي الشين ضادا استطل"}]},{"title":"باب معرفة التجويد","items":[{"t":"b","s":"والأخذ بالتجويد حتم لازم","a":"من لم يجود القرآن آثم"},{"t":"b","s":"لأنه به الإله أنزلا","a":"وهكذا منه إلينا وصلا"},{"t":"b","s":"وهو أيضا حلية التلاوة","a":"وزينة الأداء والقراءة"},{"t":"b","s":"وهو إعطاء الحروف حقها","a":"من صفة لها ومستحقها"},{"t":"b","s":"ورد كل واحد لأصله","a":"واللفظ في نظيره كمثله"},{"t":"b","s":"مكملا من غير ما تكلف","a":"باللطف في النطق بلا تعسف"},{"t":"b","s":"وليس بينه وبين تركه","a":"سوى رياضة امرئ بفكه"}]},{"title":"باب الترقيق","items":[{"t":"b","s":"فرققن مستفلا من أحرف","a":"وحاذرن تفخيم لفظ الألف"}]},{"title":"باب استعمال الحروف","items":[{"t":"b","s":"وهمز الحمد أعوذ اهدنا","a":"ألله ثم لام لله لنا"},{"t":"b","s":"وليتلطف وعلى الله ولا الض","a":"والميم من مخمصة ومن مرض"},{"t":"b","s":"وباء برق باطل بهم بذي","a":"فاحرص على الشدة والجهر الذي"},{"t":"b","s":"فيها وفي الجيم كحب الصبر","a":"ربوة اجتثت وحج الفجر"},{"t":"b","s":"وبينن مقلقلا إن سكنا","a":"وإن يكن في الوقف كان أبينا"},{"t":"b","s":"وحاء حصحص أحطت الحق","a":"وسين مستقيم يسطوا يسقوا"}]},{"title":"باب الراءات","items":[{"t":"b","s":"ورقق الراء إذا ما كسرت","a":"كذاك بعد الكسر حيث سكنت"},{"t":"b","s":"إن لم تكن من قبل حرف استعلا","a":"أو كانت الكسرة ليست أصلا"},{"t":"b","s":"والخلف في فرق لكسر يوجد","a":"وأخف تكريرا إذا تشدد"}]},{"title":"باب اللامات","items":[{"t":"b","s":"وفخم اللام من اسم الله","a":"عن فتح اوضم كعبد الله"},{"t":"b","s":"وحرف الاستعلاء فخم واخصصا","a":"الاطباق أقوى نحو قال والعصا"},{"t":"b","s":"وبين الاطباق من أحطت مع","a":"بسطت والخلف بنخلقكم وقع"},{"t":"b","s":"واحرص على السكون في جعلنا","a":"أنعمت والمغضوب مع ضللنا"},{"t":"b","s":"وخلص انفتاح محذورا عسى","a":"خوف اشتباهه بمحظورا عصى"},{"t":"b","s":"وراع شدة بكاف وبتا","a":"كشرككم وتتوفى فتنتا"},{"t":"b","s":"وأولي مثل وجنس إن سكن","a":"أدغم كقل رب وبل لا وأبن"},{"t":"b","s":"في يوم مع قالوا وهم وقل نعم","a":"سبحه لا تزغ قلوب فالتقم"}]},{"title":"باب الضاد والظاء","items":[{"t":"b","s":"والضاد باستطالة ومخرج","a":"ميز من الظاء وكلها تجي"},{"t":"b","s":"في الظعن ظل الظهر عظم الحفظ","a":"أيقظ وانظر عظم ظهر اللفظ"},{"t":"b","s":"ظاهر لظى شواظ كظم ظلما","a":"أغلظ ظلام ظفر انتظر ظما"},{"t":"b","s":"أظفر ظنا كيف جا وعظ سوى","a":"عضين ظل النحل زخرف سوا"},{"t":"b","s":"فظلت ظلتم وبروم ظلوا","a":"كالحجر ظلت شعرا نظل"},{"t":"b","s":"يظللن محظورا مع المحتظر","a":"وكنت فظا وجميع النظر"},{"t":"b","s":"إلا بويل وهل وأولى ناضره","a":"والغيظ لا الرعد وهود قاصره"},{"t":"b","s":"والحظ لا الحض على الطعام","a":"وفي ضنين الخلاف سامي"},{"t":"b","s":"وإن تلاقيا البيان لازم","a":"أنقض ظهرك يعض الظالم"},{"t":"b","s":"واضطر مع وعظت مع أفضتم","a":"وصف ها جباههم عليهم"},{"t":"b","s":"وأظهر الغنة من نون","a":"ومن ميم إذا ما شددا وأخفين"},{"t":"b","s":"الميم إن تسكن بغنة عند الباء","a":"على المختار من أهل الأداء"},{"t":"b","s":"وأظهرنها عند باقي الأحرف","a":"واحذر لدى واو وفا أن تختفي"}]},{"title":"باب النون الساكنة والتنوين","items":[{"t":"b","s":"وحكم تنوين ونون يلفى","a":"اظهار ادغام وقلب إخفا"},{"t":"b","s":"فعند حرف الحلق أظهر وادغم","a":"في اللام والرا لا بغنة لزم"},{"t":"b","s":"وأدغمن بغنة في يومن","a":"إلا بكلمة كدنيا عنونوا"},{"t":"b","s":"والقلب عند البا بغنة كذا","a":"إخفا لدى باقي الحروف أخذا"}]},{"title":"باب المد والقصر","items":[{"t":"b","s":"والمد لازم وواجب أتى","a":"وجائز وهو وقصر ثبتا"},{"t":"b","s":"فلازم إن جاء بعد حرف مد","a":"ساكن حالين وبالطول يمد"},{"t":"b","s":"وواجب إن جاء قبل همزة","a":"متصلا إن جمعا بكلمة"},{"t":"b","s":"وجائز إذا أتى منفصلا","a":"أو عرض السكون وقفا مسجلا"}]},{"title":"باب الوقف على أواخر الكلم","items":[{"t":"b","s":"وبعد تجويدك للحروف","a":"لا بد من معرفة الوقوف"},{"t":"b","s":"والابتداء وهي تنقسم إذن","a":"ثلاثة تام وكاف وحسن"},{"t":"b","s":"وهي لما تم فإن لم يوجد","a":"تعلق أوكان معنى فابتدي"},{"t":"b","s":"فالتام فالكافي ولفظا فامنعن","a":"إلا رؤوس الآي جوز فالحسن"},{"t":"b","s":"وغير ما تم قبيح وله","a":"يوقف مضطرا ويبدا قبله"},{"t":"b","s":"وليس في القرآن من وقف وجب","a":"ولا حرام غير ما له سبب"}]},{"title":"باب المقطوع والموصول والتاء","items":[{"t":"b","s":"واعرف لمقطوع وموصول وتا","a":"في مصحف الإمام فيما قد أتى"},{"t":"b","s":"فاقطع بعشر كلمات أن لا","a":"مع ملجأ ولا إله إلا"},{"t":"b","s":"وتعبدوا ياسين ثاني هود لا","a":"يشركن تشرك يدخلن تعلوا على"},{"t":"b","s":"أن لا يقولوا لا إله إن ما","a":"بالرعد كالمفتوح صل وعن ما"},{"t":"b","s":"نهوا اقطعوا من ما بروم والنسا","a":"خلف المنافقين أم من أسسا"},{"t":"b","s":"فصلت النسا وذبح حيث ما","a":"وأن لم المفتوح كسر إن ما"},{"t":"b","s":"الانعام والمفتوح يدعون معا","a":"وخلف الانفال ونحل وقعا"},{"t":"b","s":"وكل ما سألتموه واختلف","a":"ردوا كذا قل بئسما والوصل صف"},{"t":"b","s":"خلفتموني واشتروا في ما","a":"اقطعا أوحي أفضتم اشتهت نبلوا معا"},{"t":"b","s":"ثاني فعلن وقعت روم كلا","a":"تنزيل شعراء وغيرها صلا"},{"t":"b","s":"فأينما كالنحل صل ومختلف","a":"في الشعرا الاحزاب والنسا وصف"},{"t":"b","s":"وصل فإلم هود ألن نجعلا","a":"نجمع كيلا تحزنوا تأسوا على"},{"t":"b","s":"حج عليك حرج وقطعهم","a":"عن من يشاء من تولى يوم هم"},{"t":"b","s":"ومال هذا والذين هؤلا","a":"تحين في الإمام وصلا وقيل لا"},{"t":"b","s":"كالوهم أو وزنوهم صل","a":"كذا من أل ويا وها لا تفصل"}]},{"title":"باب هاء التأنيث التي رسمت تاء","items":[{"t":"b","s":"ورحمتا الزخرف بالتا زبره","a":"الاعراف روم هود كاف البقرة"},{"t":"b","s":"نعمتها ثلاث نحل ابرهم","a":"معا أخيرات عقود الثان هم"},{"t":"b","s":"لقمان ثم فاطر كالطور","a":"عمران لعنت بها والنور"},{"t":"b","s":"وامرأت يوسف عمران القصص","a":"تحريم معصيت بقد سمع يخص"},{"t":"b","s":"شجرت الدخان سنت فاطر","a":"كلا والانفال وحرف غافر"},{"t":"b","s":"قرت عين جنت في وقعت","a":"فطرت بقيت وابنت وكلمت"},{"t":"b","s":"أوسط الأعراف وكل مااختلف","a":"جمعا وفردا فيه بالتاء عرف"}]},{"title":"باب همز الوصل","items":[{"t":"b","s":"وابدأ بهمز الوصل من فعل بضم","a":"إن كان ثالث من الفعل يضم"},{"t":"b","s":"واكسره حال الكسر والفتح وفي","a":"الاسماء غير اللام كسرها وفي"},{"t":"b","s":"ابن مع ابنة امرئ واثنين","a":"وامرأة واسم مع اثنتين"},{"t":"b","s":"وحاذر الوقف بكل الحركة","a":"إلا إذا رمت فبعض حركة"},{"t":"b","s":"إلا بفتح أو بنصب وأشم","a":"إشارة بالضم في رفع وضم"}]},{"title":"خاتمة","items":[{"t":"b","s":"وقد تقضى نظمي المقدمة","a":"مني لقارئ القرآن تقدمة"},{"t":"b","s":"والحمد لله لها ختام","a":"ثم الصلاة بعد والسلام"},{"t":"b","s":"على النبي المصطفى محمدا","a":"وآله وصحبه ذوي الهدى"},{"t":"b","s":"أبياتها قاف وزاي بالعدد","a":"من يحسن التجويد يظفر بالرشد"}]}]}