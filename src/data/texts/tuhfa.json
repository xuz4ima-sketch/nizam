{"id":"tuhfa","title":"تحفة الأطفال والغلمان","author":"سليمان الجمزوري","category":"tajwid","kind":"poem","vocalized":true,"source":{"name":"ويكي مصدر (Wikisource)","page":"تحفة الأطفال","revid":594187,"url":"https://ar.wikisource.org/w/index.php?oldid=594187","license":"CC BY-SA 4.0"},"sections":[{"title":"المقدمة","items":[{"t":"b","s":"يَقُولُ رَاجِي رَحمةِ الْغَفُورِ","a":"دَوْمَاً سُلَيْمَانُ هُوَ الْجَمْزُورِى"},{"t":"b","s":"الْحَمْدُ لِلَّهِ مُصَلِّياً عَلى","a":"مُحَمَدٍ وآلِهِ وَمَنْ تَلاَ"},{"t":"b","s":"وَبَعْدُ هذَا النَّظْمُ لِلْمُرِيدِ","a":"في النُونِ والتَّنْوِينِ وَالْمُدُودِ"},{"t":"b","s":"سَمَّيتُهُ بِتُحفَة الأَطْفَالِ","a":"عَنْ شَيْخِنَا الْمِيهِىِّ ذِي الْكَمالِ"},{"t":"b","s":"أَرْجُو بِه أَنْ يَنْفَعَ الطُّلاَّبَا","a":"وَالأَجْرَ وَالْقَبُولَ وَالثَّوَابا"}]},{"title":"النون الساكنة والتنوين","items":[{"t":"b","s":"لِلنُّونِ إِنْ تَسْكُنْ وَلِلتَّنْوِينِ","a":"أَرْبَعُ أَحْكَامٍ فَخُذْ تَبْيِينِي"},{"t":"b","s":"فَالأَوَّلُ الإظْهَارُ قَبْلَ أَحْرُفِ","a":"لِلْحَلْقِ سِتٍ رُتِّبَتْ فَلتَعْرِفِ"},{"t":"b","s":"هَمْزٌ فَهَاءٌ ثُمَّ عَيْنٌ حَاءُ","a":"مُهْمَلَتَانِ ثُمَّ غَيْنٌ خَاءُ"},{"t":"b","s":"والثَّاني إِدْغَامٌ بِستَّةٍ أَتَتْ","a":"فِي يَرْمَلُونَ عِنْدَهُمْ قَدْ ثَبَتَتْ"},{"t":"b","s":"لَكِنَّهَا قِسْمَانِ قِسْمٌ يُدْغَمَا","a":"فِيهِ بِغُنَّةٍ بِيَنْمُو عُلِمَا"},{"t":"b","s":"إِلاَّ إِذَا كَانَا بِكِلْمَةٍ فَلاَ","a":"تُدْغِمْ كَدُنْيَا ثُمَّ صِنْوَانٍ تَلاَ"},{"t":"b","s":"وَالثَّاني إِدْغَامٌ بِغَيْرِ غُنَّةْ","a":"في اللاَّمِ وَالرَّا ثُمَّ كَرّرَنَّهْ"},{"t":"b","s":"وَّالثَالثُ الإِقْلاَبُ عِنْدَ الْبَاءِ","a":"مِيماً بِغُنَةٍ مَعَ الإِخْفَاءِ"},{"t":"b","s":"وَالرَّابِعُ الإِخْفَاءُ عِنْدَ الْفاضِلِ","a":"مِنَ الحُرُوفِ وَاجِبٌ لِلْفَاضِلِ"},{"t":"b","s":"في خَمْسَةٍ مِنْ بَعْدِ عَشْرٍ رَمْزُهَا","a":"فِي كِلْمِ هذَا البَيْتِ قَدْ ضَمَّنْتُهَا"},{"t":"b","s":"صِفْ ذَا ثَنَا كَمْ جَادَ شَخْصٌ قَدْ سمَا","a":"دُمْ طَيَّباً زِدْ فِي تُقَىً ضَعْ ظَالِمَا"}]},{"title":"الميم والنون المشددتين","items":[{"t":"b","s":"وَغُنَّ مِيماً ثُمَّ نُوناً شُدِّدَا","a":"وَسَمِّ كُلاً حَرْفَ غُنَّةٍ بَدَا"}]},{"title":"الميم الساكنة","items":[{"t":"b","s":"وَالِميمُ إِنْ تَسْكُنْ تَجِى قَبْلَ الْهِجَا","a":"لاَ أَلفٍ لَيِّنَةٍ لِذِى الْحِجَا"},{"t":"b","s":"أَحْكَامُهَا ثَلاَثَةٌ لِمَنْ ضَبَطْ","a":"إِخْفَاءٌ ادْغَامٌ وَإِظْهَارٌ فَقَطْ"},{"t":"b","s":"فَالأَوَّلُ الإِخْفَاءُ عِنْدَ الْبَاءِ","a":"وَسَمِّهِ الشَّفْوِىَّ لِلْقُرَّاءِ"},{"t":"b","s":"وَالثَّانى إِدْغَامٌ بِمِثْلِهَا أَتَى","a":"وَسَمِّ إدغاماً صَغِيراً يَا فَتَى"},{"t":"b","s":"وَالثَّالِثُ الإِظْهَارُ فِى الْبَقِيَّةْ","a":"مِنْ أَحْرُفٍ وَسَمِّهَا شَفْوِيَّهْ"},{"t":"b","s":"وَاحْذَرْ لَدَى وَاوٍ وَفَا أَنْ تَخْتَفىِ","a":"لِقُرْبِهَا وَلاتحادِ فَاعْرِفِ"}]},{"title":"لام آل ولام الفعل","items":[{"t":"b","s":"لِلاَمِ أَلْ حَالاَنِ قَبْلَ الأَحْرُفِ","a":"أُولاَهُمَا إِظْهَارُهَا فَلْتَعْرِفِ"},{"t":"b","s":"قَبْلَ ارْبَعٍ مَعْ عَشْرَةٍ خُذْ عِلْمَهُ","a":"مِنَ ابْغِ حَجَّكَ وَخَفْ عَقِيمهُ"},{"t":"b","s":"ثَانِيهِمَا إِدْغَامُهَا فى أَرْبَعٍ","a":"وَعَشْرَةٍ أَيْضاً وَرَمْزَهَا فَعِ"},{"t":"b","s":"طِبْ ثُمَّ صِلْ رُحْمَاً تَفُزْ ضِفْ ذَا نِعَم","a":"دَعْ سُوءَ ظَنٍ زُرْ شَرِيفَاً لِلْكَرَم"},{"t":"b","s":"وَاللاَّمَ الاُولَى سَمِّهَا قَمْرِيَّهْ","a":"وَاللاَّمَ الاُخْرىَ سَمِّهَا شَمْسِيَّهْ"},{"t":"b","s":"وأظْهِرَنَّ لاَمَ فِعْلٍ مُطْلَقاً","a":"فى نَحْوِ قُلْ نَعَمْ وَقُلْنَا وَالْتَقَى"}]},{"title":"المثلين والمتقاربين والمتجانسين","items":[{"t":"b","s":"إِنْ فِي الصِّفَاتِ وَالمَخَارِجِ اتَّفَقْ","a":"حَرْفَانِ فَالْمِثْلاَنِ فِيهِمَا أَحَقْ"},{"t":"b","s":"وَإِنْ يَكُونَا مَخْرَجا ًتَقَارَبَا","a":"وَفي الصِّفَاتِ اخْتَلَفَا يُلَقَّبَا"},{"t":"b","s":"مُتْقَارِبَيْنِ أَوْ يَكُونَا اتَّفَقَا","a":"فِي مَخْرَجٍ دُونَ الصِّفَاتِ حُقِّقَا"},{"t":"b","s":"بِالْمُتَجَانِسَيْنِ ثُمَّ إِنْ سَكَنْ","a":"أَوَّلُ كُلٍّ فَالصَّغِيرَ سَمِّيَنْ"},{"t":"b","s":"أَوْ حُرِّكَ الحَرْفَانِ فى كُلٍّ فَقُلْ","a":"كُلٌّ كَبِيرُ وافْهَمَنْهُ بِالْمُثُلْ"}]},{"title":"أقسام المد","items":[{"t":"b","s":"وَالمَدُّ أَصْلِىُّ وَ فَرْعِىٌّ لَهُ","a":"وَسَمِّ أَوَّلاً طَبِيعِيّاً وَهُو"},{"t":"b","s":"مَالاَ تَوَقُّفٌ لَهُ عَلى سَبَبْ","a":"وَلابِدُونِهِ الحُرُوفُ تُجْتَلَبْ"},{"t":"b","s":"بلْ أَىُّ حَرْفٍ غَيْرُ هَمْزٍ أَوْ سُكُونْ","a":"جَا بَعْدَ مَدٍّ فَالطَّبِيِعىَّ يَكُونْ"},{"t":"b","s":"وَالآخَرُ الْفَرْعِىُّ مَوْقُوفٌ عَلي","a":"سَبَبْ كَهَمْزٍ أَوْ سُكُونٍ مُسْجَلاً"},{"t":"b","s":"حُرُوفُهُ ثَلاَثَةٌ فَعِيهَا","a":"مِنْ لَفْظِ وَاىٍ وَهْىَ فى نُوحِيهَا"},{"t":"b","s":"وَالكَسْرُ قَبْلَ الْيَا وَقَبْلَ الْواوِ ضَمْ","a":"شَرْطٌ وَفَتْحٌ قَبْلَ أَلفٍ يُلْتَزَمْ"},{"t":"b","s":"وَاللِّينُ مِنْهَا الْيَا وَوَاوٌ سَكَنَا","a":"إِنِ انْفِتَاحٌ قَبْلَ كُلٍّ أُعْلِنَا"}]},{"title":"أحكام المد","items":[{"t":"b","s":"لِلْمَدِّ أَحْكَامٌ ثَلاَثَةٌ تَدُومْ","a":"وَهْيَ الْوُجُوبُ وَالْجَوَازُ وَاللُّزُومْ"},{"t":"b","s":"فَوَاجِبٌ إِنْ جَاءَ هَمْزٌ بَعْدَ مَدْ","a":"فِي كِلْمَةٍ وَذَا بِمُتَّصْلٍ يُعَدْ"},{"t":"b","s":"وَجَائزٌ مَدٌ وَقَصْرٌ إِنْ فُصِل","a":"كُلٌّ بِكِلْمَةٍ وَهَذَا المُنْفَصِلْ"},{"t":"b","s":"وَمِثْلُ ذَا إِنْ عَرَضَ السُّكُونُ","a":"وَقْفَاً كَتَعْلَمُونَ نَسْتَعِينُ"},{"t":"b","s":"أَوْ قُدِّمَ الْهَمْزُ عَلَي المَدِّ وَذَا","a":"بَدَلْ كَآمَنُوا وَإِيَماناً خُذَا"},{"t":"b","s":"وَلاَزِمٌ إِنِ السُّكُونُ أُصِّلاَ","a":"وَصْلاَ وَوَقْفاً بَعْدَ مَدٍّ طُوّلاَ"}]},{"title":"أقسام المد اللازم","items":[{"t":"b","s":"أَقْسَامُ لاَزِمٍ لَدَيهم أَرْبَعَةْ","a":"وَتِلْكَ كِلْمِيُّ وَحَرْفِيٌّ مَعَهْ"},{"t":"b","s":"كِلاَهُمَا مُخَفَّفٌ مُثَقَّلُ","a":"فَهَذِهِ أَرْبَعَةٌ تُفَصَّلُ"},{"t":"b","s":"فَإِنْ بِكِلْمَةٍ سُكُونٌ اجْتَمَعْ","a":"مَعْ حَرْفِ مَدٍّ فَهْوَ كِلْمِيُّ وَقَعْ"},{"t":"b","s":"أَوْ في ثُلاَثِيِّ الحُرُوفِ وُجِدَا","a":"وَالمَدُّ وَسْطُهُ فَحَرْفِيٌّ بَدَا"},{"t":"b","s":"كِلاَهُمَا مُثَقّلٌ إِنْ أُدْغِمَا","a":"مَخَفَّفٌ كُلُّ إِذَا لَمْ يُدْغَمَا"},{"t":"b","s":"وَاللاَّزِمُ الْحَرفِيُّ أَوَّلَ السُّوَرْ","a":"وُجُودُهُ وَفِي ثَمَانٍ انحَصَرْ"},{"t":"b","s":"يَجْمَعُهَا حُرُوفُ كَمْ عَسَلْ نَقَصْ","a":"وَعَيْنُ ذُو وَجْهَيْنِ والطُّولُ أَخَصْ"},{"t":"b","s":"وَمَا سِوَي الحَرْفِ الثُّلاَثِي لاَ أَلِفْ","a":"فَمُدُّه مَدّاً طَبِيعِيَّا أُلِفْ"},{"t":"b","s":"وَذَاكَ أَيْضاً فِي فَوَاتِحِ السُّوَرْ","a":"فِي لَفْظِ حَيٍّ طَاهِرٍ قَدِ انْحَصَرْ"},{"t":"b","s":"وَيَجْمَعُ الْفَوَاتِحَ الأَرْبَعْ عَشَرْ","a":"صِلْهُ سُحَيْراً مَنْ قَطَعْك ذَا اشْتَهَرْ"}]},{"title":"الخاتمة","items":[{"t":"b","s":"وَتَمَّ ذَا النَّظْمُ بِحَمْدِ اللَّهِ","a":"عَلَى تَمَامِهِ بِلاَ تَنَاهِى"},{"t":"b","s":"أَبْيَاتُهُ نَدٌّ بَداَ لِذِى النُّهَى","a":"تَارِيخُهُ بُشْرَى لِمَنْ يُتْقِنُهَا"},{"t":"b","s":"ثُمَّ الصَّلاَةُ وَالسَّلاَمُ أَبَداَ","a":"عِلى خِتَامِ الأَنْبِيَاءِ أَحْمَدَا"},{"t":"b","s":"وَالآلِ وَالصَّحْبِ وَكُلِّ تَابِعِ","a":"وَكُلِّ قَارِئٍ وكُلِّ سَامِعِ"}]}]}